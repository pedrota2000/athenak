# AthenaK input file: 2D driven turbulence in a conformal relativistic fluid
# Data set for the fluid/gravity metric coefficients (four-velocity + energy density).
#
# Build:  cmake -D PROBLEM=fg_turb2d -D Athena_ENABLE_MPI=ON ... (see README.md)
# Run:    ./athena -i 2d_conformal_turb_1024.athinput
#
# Physics summary (details in README.md):
#   * SR hydro, ideal-gas EOS with gamma = d/(d-1) = 3/2 for d = 3 space-time dims,
#     so p = e_int/2 exactly and T^mu_mu = -rho exactly.  rho is set 10^4 x smaller than
#     e_int, so T = diag(-e,p,p,p) with p/e = 0.49995 (0.01% trace anomaly).  The FULL
#     T^{mu nu}, with e = dens + eint, is the one the code conserves exactly and the one
#     to use: e is then the fluid/gravity energy density to 1 part in 10^4.  rho is also
#     output pointwise as "dens" so the anomaly can be checked rather than assumed.
#   * driving_type = 2 (added for these runs) drives from a random stream function:
#     exactly divergence-free in-plane, F_z = 0 (so u^z stays identically zero), and
#     isotropic.  driving_type = 0 is non-solenoidal in 2D and drives u^z; driving_type = 1
#     is solenoidal but over-drives small k_y by k_x/k_y (3.6x anisotropy measured).
#   * Forcing is band-limited to |k| L/2pi in [22,26], i.e. at 1/24 of the box, leaving
#     k < 22 free for the 2D INVERSE cascade and k > 26 for the direct enstrophy cascade.
#   * NO large-scale sink.  rel_cooling is available (a covariant sink -crate*p*u^mu) but
#     is left OFF: it is exactly the "large-scale friction" that Westernacher-Schneider
#     (arXiv:1710.04264) argues lies outside the regime of validity of the fluid/gravity
#     duality, and it acts along u^mu at ALL scales, so it would contaminate precisely the
#     large-scale band the metric is reconstructed from.  Instead this is a *transient*
#     quasi-steady state: run until the inverse cascade approaches the box scale, stopping
#     before the energy piles up there (watch Ekin in the .hst file).
#   * THIS RUN IS A SPIN-UP, NOT THE DATA SET.  While the drive is on, d_mu T^{mu nu} = f^nu
#     pointwise, so the profiles are not solutions of the fluid/gravity constraint and the
#     reconstructed metric does not solve the Einstein equations.  Restart with
#     analysis_window_decay.athinput and take the data from the unforced evolution -- in 2D
#     that costs almost nothing, since freely evolving 2D turbulence conserves energy in the
#     inviscid limit (only enstrophy decays) and so stays steady for many eddy times.
#   * In 2D most of the injected energy goes up-scale into large-scale kinetic energy rather
#     than into heat, so the temperature drifts only slowly; check p/e and anom in the .hst
#     file rather than assuming it.

<comment>
problem  = 2D conformal relativistic turbulence, inverse cascade
reference = fluid/gravity metric coefficients

<job>
basename = fgturb2d

# NOTE: keep the box volume equal to 1 (all three extents of unit length, including the
# collapsed x3 direction).  The driver normalizes its sums with 1/(nx1*nx2*nx3), i.e. it
# assumes a unit volume, so dedt is the energy injection rate per unit volume only then.
<mesh>
nghost   = 4          # wenoz + fofc requires >= 4
nx1      = 1024        # Number of zones in X1-direction
x1min    = 0.0
x1max    = 1.0
ix1_bc   = periodic
ox1_bc   = periodic

nx2      = 1024        # Number of zones in X2-direction
x2min    = 0.0
x2max    = 1.0
ix2_bc   = periodic
ox2_bc   = periodic

nx3      = 1           # 2D run: MUST be 1
x3min    = -0.5
x3max    = 0.5
ix3_bc   = periodic
ox3_bc   = periodic

<meshblock>
nx1      = 128
nx2      = 128
nx3      = 1

<coord>
special_rel = true

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 20.0      # ~140 forcing-scale eddy times
ndiag      = 1000

<hydro>
eos         = ideal
reconstruct = wenoz    # probe-verified choice for these turbulence runs
rsolver     = hlle     # hllc is also available for SR hydro
fofc        = true     # first-order flux correction (implemented for SR, see hydro_fofc.cpp)
gamma       = 1.5      # = d/(d-1) with d = 3: conformal.  Use 1.3333333 for d = 4.
dfloor      = 1.0e-10
pfloor      = 1.0e-10
gamma_max   = 20.0     # Lorentz-factor ceiling

# NO large-scale friction (see header).  To experiment with a thermostat/drag anyway,
# set rel_cooling = true and crate_rel ~ dedt/p0 -- but then the reconstructed metric is
# sourced at every scale, not just in the forcing band.
rel_cooling = false

<problem>
pgen_name   = fg_turb2d   # documentation only: the pgen is selected at BUILD time
                          # by -D PROBLEM=fg_turb2d, not by this line
user_hist   = true     # enroll the fluid/gravity diagnostics in the .hst file
d_spacetime = 3.0      # d in p = e/(d-1); must match <hydro>/gamma = d/(d-1)
dens0       = 1.0e-4   # rest-mass density = the (tiny) conformal anomaly
temp0       = 5000.0   # ideal-gas T = p/rho (NOT the CFT temperature, which is e^(1/d)
                       # ~ 1 here).  p0 = 0.5, e_int0 = 1.0, e0 = 1.0001, so
                       # rho/e_int = 1/(2*temp0) = 1e-4.  Raising temp0 shrinks the anomaly
                       # for free -- the conformal sound speed is sqrt(Gamma-1) = 0.707
                       # regardless -- until the c2p inversion loses conditioning, which
                       # works with q = tau/D ~ 2*temp0 (fine to ~1e4-1e5 in double).

<turb_driving>
driving_type       = 2        # 2D isotropic solenoidal (stream-function) driving
nlow               = 22       # forcing band: 22 <= |k|L/2pi <= 26
                              # k_max/k_f = 341/24 = 14.2.  This ratio picks the
                              # spectrum: >~8-16 gives E(k) ~ k^-2 (the setting
                              # arXiv:1710.04264 argues is natural for fluid/gravity,
                              # being the infinite-Re, no-large-scale-friction limit);
                              # a larger k_f pushes the force into the dissipation
                              # range and returns Kraichnan-Kolmogorov k^-5/3.
nhigh              = 26
expo               = 1.6666667
exp_prp            = 1.6666667
exp_prl            = 0.0
dedt               = 150      # NOT the physical injection rate.  The driver normalizes
                              # against the rest-mass density D but does its work against
                              # the true momentum S_i, so it overshoots by (e+p)/rho =
                              # 3*temp0 = 1.5e4.  True rate eps = dedt/(3*temp0).  With no
                              # sink the energy accumulates, (e+p) v^2 ~ eps*t, hence
                              #   dedt = 3*temp0*(e+p)*v_target^2/t_sample
                              # This value targets v_rms ~ 0.3 at t ~ 15.  Verified at
                              # 128^2: dedt=1440 gave 83% of the predicted E_kin at t=4.
tcorr              = 0.0      # white-noise-in-time, as in arXiv:1710.04264
                              # (any value <= 1e-6 selects white noise); set ~0.1, the
                              # eddy time at the forcing scale, for an OU force instead
eint_over_dens_max = 1.0e6    # disable the legacy e_int <= 40*rho clip (would break conformality)

<output1>
file_type = hst
dt        = 0.01

<output2>
file_type = bin
variable  = hydro_w      # dens, velx, vely, velz (= u^x,u^y,u^z), eint
dt        = 0.2          # survey cadence; the residuals need the dense window below

<output3>
file_type = rst
dt        = 2.0
